{
  "name": "llm-gateway",
  "version": "0.0.1",
  "description": "Multi-tenant LLM API gateway with rate limiting, retry, idempotency, and semantic caching",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.app.json",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.tools.json && tsc -p tsconfig.test.json --noEmit",
    "dev": "NODE_ENV=development tsx watch src/server.ts",
    "start": "node dist/server.js",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "lint": "eslint src tests",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [],
  "author": "Pedro Ives Silva Santos <contact.pedroives@gmail.com>",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=11.1.1 <12"
  },
  "packageManager": "pnpm@11.1.1",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testcontainers/postgresql": "^12.2.0",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^4.1.11",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.12.0",
    "pino-pretty": "^13.2.0",
    "testcontainers": "^12.2.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@fastify/sensible": "^6.0.6",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.12.5",
    "postgres": "^3.4.9",
    "uuid": "^14.0.2"
  }
}
